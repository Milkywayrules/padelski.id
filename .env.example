# padelski.id — Doppler key catalog (values live in Doppler only)
# Configs: dev | dev_personal | prod
#
# Setup:    bun run doppler:setup
# Validate: bun run doppler:validate
# Clear:    bun run doppler:clear          (prod requires --yes)
# Dev:      bun run dev
#
# Optional — materialize gitignored .env for file-based tools:
#   doppler secrets download --no-file --format env > .env && chmod 600 .env

# --- App tier ---
APP_ENV=                          # dev | prod
NODE_ENV=                           # development | production (optional)

# --- Public URLs ---
NEXT_PUBLIC_APP_URL=                # web public address
API_CORS_ORIGIN=                    # MUST equal NEXT_PUBLIC_APP_URL

NEXT_PUBLIC_API_URL=                # api public address
BETTER_AUTH_URL=                    # MUST equal NEXT_PUBLIC_API_URL

# --- Auth (Better Auth on Elysia /v1/auth) ---
BETTER_AUTH_SECRET=                 # min 32 chars → openssl rand -hex 32

# --- OAuth ---
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=         # callback: {BETTER_AUTH_URL}/v1/auth/callback/github

# --- Database & Redis (dev_personal / local host only) ---
DB_URL=                             # postgresql://user:pass@host:5432/padelski
REDIS_URL=                          # redis://host:6379

# --- Compose-only (dev + prod Coolify deploy; forbidden in dev_personal) ---
POSTGRES_PASSWORD=                  # compose builds DB_URL from this at deploy

# --- Email (Resend) ---
EMAIL_FROM=                         # Padelski <noreply@padelski.id>
RESEND_API_KEY=

# --- Object storage (R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PREFIX=                          # dev/ | prod/ — must match APP_ENV

# --- Observability (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Forbidden in Doppler ---
# DOPPLER_TOKEN
# ENV_SKIP_VALIDATION
# CI

# --- Doppler-injected (read-only) ---
# DOPPLER_PROJECT
# DOPPLER_CONFIG                      # dev | dev_personal | prod
# DOPPLER_ENVIRONMENT
