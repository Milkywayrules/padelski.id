#!/usr/bin/env bash
# verasic-github-governance — block direct push to default branch (soft layer).
#
# Primary wiring: ensure-pre-push-gate.sh injects this script at the TOP of
# .git/hooks/pre-push (before lefthook's LEFTHOOK=0 exit). Re-run after lefthook install.
# Fallback: core.hooksPath pointing at .github/verasic-governance/hooks/
set -euo pipefail

if [[ "${VERASIC_GOVERNANCE_BYPASS:-}" == "1" ]]; then
  echo "verasic-github-governance: pre-push bypass active (VERASIC_GOVERNANCE_BYPASS=1)" >&2
  exit 0
fi

remote="${1:-origin}"
url="${2:-}"

default_branch="$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || true)"
if [[ -z "$default_branch" ]]; then
  for candidate in main master; do
    if git show-ref --verify --quiet "refs/heads/$candidate" 2>/dev/null; then
      default_branch="$candidate"
      break
    fi
  done
fi
if [[ -z "$default_branch" ]]; then
  default_branch="main"
fi

read_count=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  read_count=$((read_count + 1))

  if [[ "$local_ref" == "(delete)" ]]; then
    if [[ "${remote_ref:-}" == "refs/heads/$default_branch" ]]; then
      echo "verasic-github-governance: deletion of '$default_branch' blocked — open a PR instead" >&2
      exit 1
    fi
    continue
  fi

  if [[ "${remote_ref:-}" == "refs/heads/$default_branch" ]]; then
    echo "verasic-github-governance: push to '$default_branch' blocked (refspec updates default branch) — open a PR instead" >&2
    echo "verasic-github-governance: break-glass: VERASIC_GOVERNANCE_BYPASS=1 git push ..." >&2
    exit 1
  fi
done

if [[ "$read_count" -eq 0 ]]; then
  echo "verasic-github-governance: pre-push received no ref list — refusing push (fail-closed)" >&2
  exit 1
fi

exit 0
